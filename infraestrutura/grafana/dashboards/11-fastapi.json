{
  "uid": "clustering-api",
  "title": "11 — Clustering API Observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requisições por segundo",
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (projeto,status) (rate(clustering_api_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência p50 / p95 / p99 (s)",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le,projeto) (rate(clustering_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{projeto}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le,projeto) (rate(clustering_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{projeto}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le,projeto) (rate(clustering_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{projeto}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Falhas de inferência",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (projeto) (rate(clustering_api_inference_errors_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}